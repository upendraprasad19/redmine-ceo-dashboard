# Redmine
REDMINE_URL=https://redmine.yourcompany.com/
REDMINE_API_KEY=your_redmine_api_key

# Neon Postgres (primary DB)
DATABASE_URL=postgresql://user:password@host:port/db?sslmode=require

# Auth
JWT_SECRET=your-random-jwt-secret-at-least-32-chars
CRON_SECRET=your-cron-secret-for-vercel-cron-auth

# Telegram Bot (optional — without it, bot features and notifications are disabled)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenRouter (optional — required for AI chat / intelligence features)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o

# Upstash Redis (optional — required for chat history and Telegram session state)
UPSTASH_REDIS_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your_redis_token

# SMTP (optional — used by forgot-password and report emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM="CEO Dashboard <noreply@yourcompany.com>"

# Slack (optional — Slack bot integration)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# GitHub (optional — used for auto-push scripts)
GITHUB_TOKEN=your_github_token
GITHUB_REPO=your-org/your-repo

# Vercel (optional — used for deployment automation)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Neon API (optional — used for DB management)
NEON_API_KEY=
NEON_PROJECT_ID=
